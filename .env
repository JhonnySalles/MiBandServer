# Configuração da Porta do Frontend
# Como o Raspberry Pi pode hospedar vários sites, você pode alterar esta porta
# para evitar conflitos (ex: 8080, 8081, 3000, etc.)
FRONTEND_PORT=8080

# URL do Backend (API)
# Caso o backend esteja rodando no mesmo Raspberry Pi e o frontend precise fazer
# chamadas a ele pelo navegador do cliente, defina o IP ou domínio do Raspberry.
# Para desenvolvimento local, localhost funciona.
VITE_API_URL=http://localhost:8000

# Configuração de Logs (Rastreabilidade e Gravação Externa em HD)
# E.g., para HD Externo no Raspberry Pi: /media/external_hdd/logs ou /mnt/hd/logs
LOG_DIR=./logs
LOG_RETENTION_DAYS=30
LOG_FILENAME=MiBandServer.log
