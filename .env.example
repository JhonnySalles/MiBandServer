# =======================================================
# Configurações de Portas e Rede (Evita portas 3000, 8000, 8080)
# =======================================================
FRONTEND_PORT=8090
BACKEND_PORT=8190
REDIS_PORT=6389

# Endereço base da API para chamadas do Frontend no navegador
VITE_API_URL=http://localhost:8190

# =======================================================
# Configurações do Backend e Banco de Dados
# =======================================================
PORT=8190
HOST=0.0.0.0
DB_URL=sqlite:///./data/miband.db
REDIS_URL=redis://localhost:6389/0

# =======================================================
# Provedor de Clima
# Opções: open-meteo (gratuito) ou openweathermap
# =======================================================
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=
WEATHER_CITY=Sao Paulo
WEATHER_LAT=-23.5505
WEATHER_LON=-46.6333

# =======================================================
# Logs
# =======================================================
LOG_DIR=./logs
LOG_RETENTION_DAYS=30
LOG_FILENAME=MiBandServer.log
